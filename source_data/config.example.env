# 이 파일은 변수 이름만 적어 둔 본보기다. 실제 값은 이 폴더의 `.env.g2b`에 넣는다.
# 저장소 루트의 `.env`는 Solar 설정이며 서로 다른 파일이다. 이름을 갈라 둔 이유는
# 같은 이름의 파일 둘이 한 트리에 있으면 서로 덮어쓰기 쉽고, 둘 다 git에 없어
# 되돌릴 방법이 없기 때문이다.

# 사전규격정보서비스(prior specification) 일반 인증키
# Encoding/Decoding 중 어느 값을 넣어도 테스트 코드가 정규화한다.
G2B_PRIOR_SPEC_SERVICE_KEY=

# 입찰공고정보서비스(bid notice) 일반 인증키
# Encoding/Decoding 중 어느 값을 넣어도 테스트 코드가 정규화한다.
G2B_BID_NOTICE_SERVICE_KEY=

# 서비스별 일 1,000건 한도에 여유를 두기 위한 실행 안전장치다.
# 최초 연동에서는 1로 낮춰 사용한다.
RFP_API_MAX_REQUESTS_PER_RUN=10
RFP_API_MAX_PAGES_PER_RUN=5
RFP_API_MAX_RETRIES=2
