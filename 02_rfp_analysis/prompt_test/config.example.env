# Required: Solar Open 250B endpoint
SOLAR_API_KEY=
SOLAR_BASE_URL=https://api.upstage.ai/v1
SOLAR_MODEL=solar-open2

# Request behavior
SOLAR_API_STYLE=openai_compatible
SOLAR_TIMEOUT_SECONDS=180
SOLAR_MAX_RETRIES=0

# Local output
PROMPT_TEST_RUNS_DIR=runs

# Optional observability: leave disabled unless credentials are configured
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=solar-prompt-test
